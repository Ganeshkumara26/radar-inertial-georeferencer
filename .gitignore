# Ignore all files by default
*

# But don't ignore directories (so git can traverse into them)
!*/

# Re-allow ONLY specific root files
!README.md
!SETUP.md
!LICENSE
!.gitignore

# Re-allow project folders
!src/**
!c/**
!firmware/**
!hw_bench/**
!out/**
!results/**
!tests/**
!uavpipe/**
!scripts/**

# Specifically ignored folders & artifacts
notebooks/
edp_fig/
__pycache__/
*.pyc
*.pyo
*.o
*.a
tests/test_ekf
tests/test_mavlink*
tests/test_ring_buffer