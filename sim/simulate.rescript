# Renode simulation script for EDP Georeferencing Coprocessor
# Full pipeline: MAVLink ATTITUDE + LOCAL_POSITION_NED + frame-sync

mach create "edp-georef-coprocessor"
machine LoadPlatformDescription @stm32h753.repl
showAnalyzer sysbus.usart1
sysbus.usart1 CreateFileBackend @uart_output.log
sysbus LoadELF @D:\Desktop\edp_firmware.elf

emulation RunFor "0.05"

# === BACKDOOR ADDRESSES ===
# 0x24000010: sim_rx_count    (4 bytes)
# 0x24000014: sim_frame_sync  (4 bytes)
# 0x24000018: sim_frame_ts    (4 bytes)
# 0x24000020: dma_buffer      (512 bytes)

# === PACKET 1: ATTITUDE (#30) at 0x24000020 ===
sysbus WriteByte 0x24000020 0xFD
sysbus WriteByte 0x24000021 0x1C
sysbus WriteByte 0x24000022 0x00
sysbus WriteByte 0x24000023 0x00
sysbus WriteByte 0x24000024 0x01
sysbus WriteByte 0x24000025 0x01
sysbus WriteByte 0x24000026 0x01
sysbus WriteByte 0x24000027 0x1E
sysbus WriteByte 0x24000028 0x00
sysbus WriteByte 0x24000029 0x00
sysbus WriteByte 0x2400002A 0xE8
sysbus WriteByte 0x2400002B 0x03
sysbus WriteByte 0x2400002C 0x00
sysbus WriteByte 0x2400002D 0x00
# roll=0.1f (0x3DCCCCCD LE)
sysbus WriteByte 0x2400002E 0xCD
sysbus WriteByte 0x2400002F 0xCC
sysbus WriteByte 0x24000030 0xCC
sysbus WriteByte 0x24000031 0x3D
# pitch=-0.05f (0xBD4CCCCD LE)
sysbus WriteByte 0x24000032 0xCD
sysbus WriteByte 0x24000033 0xCC
sysbus WriteByte 0x24000034 0x4C
sysbus WriteByte 0x24000035 0xBD
# yaw=1.57f (0x3FC90FDB LE)
sysbus WriteByte 0x24000036 0xDB
sysbus WriteByte 0x24000037 0x0F
sysbus WriteByte 0x24000038 0xC9
sysbus WriteByte 0x24000039 0x3F
# rollspeed=0.01f (0x3C23D70A LE)
sysbus WriteByte 0x2400003A 0x0A
sysbus WriteByte 0x2400003B 0xD7
sysbus WriteByte 0x2400003C 0x23
sysbus WriteByte 0x2400003D 0x3C
# pitchspeed=0.005f (0x3BA3D70A LE)
sysbus WriteByte 0x2400003E 0x0A
sysbus WriteByte 0x2400003F 0xD7
sysbus WriteByte 0x24000040 0xA3
sysbus WriteByte 0x24000041 0x3B
# yawspeed=0.02f (0x3C23D70A LE)
sysbus WriteByte 0x24000042 0x0A
sysbus WriteByte 0x24000043 0xD7
sysbus WriteByte 0x24000044 0x23
sysbus WriteByte 0x24000045 0x3C
# CRC placeholder
sysbus WriteByte 0x24000046 0x00
sysbus WriteByte 0x24000047 0x00

# Signal 40 bytes available
sysbus WriteDoubleWord 0x24000010 0x00000028
emulation RunFor "0.1"

# === PACKET 2: LOCAL_POSITION_NED (#32) at 0x24000048 ===
# Starts at offset 40 (0x28)
# Size: header(10) + payload(24) + crc(2) = 36 bytes
sysbus WriteByte 0x24000048 0xFD
sysbus WriteByte 0x24000049 0x18  # length = 24
sysbus WriteByte 0x2400004A 0x00
sysbus WriteByte 0x2400004B 0x00
sysbus WriteByte 0x2400004C 0x02  # seq
sysbus WriteByte 0x2400004D 0x01
sysbus WriteByte 0x2400004E 0x01
sysbus WriteByte 0x2400004F 0x20  # msgid = 32 (LOCAL_POSITION_NED)
sysbus WriteByte 0x24000050 0x00
sysbus WriteByte 0x24000051 0x00
# time_boot_ms = 1000
sysbus WriteByte 0x24000052 0xE8
sysbus WriteByte 0x24000053 0x03
sysbus WriteByte 0x24000054 0x00
sysbus WriteByte 0x24000055 0x00
# x=5.0f (N) (0x40A00000 LE: 00 00 A0 40)
sysbus WriteByte 0x24000056 0x00
sysbus WriteByte 0x24000057 0x00
sysbus WriteByte 0x24000058 0xA0
sysbus WriteByte 0x24000059 0x40
# y=3.0f (E) (0x40400000 LE: 00 00 40 40)
sysbus WriteByte 0x2400005A 0x00
sysbus WriteByte 0x2400005B 0x00
sysbus WriteByte 0x2400005C 0x40
sysbus WriteByte 0x2400005D 0x40
# z=-2.0f (D) (0xC0000000 LE: 00 00 00 C0)
sysbus WriteByte 0x2400005E 0x00
sysbus WriteByte 0x2400005F 0x00
sysbus WriteByte 0x24000060 0x00
sysbus WriteByte 0x24000061 0xC0
# vx=1.0f (0x3F800000 LE: 00 00 80 3F)
sysbus WriteByte 0x24000062 0x00
sysbus WriteByte 0x24000063 0x00
sysbus WriteByte 0x24000064 0x80
sysbus WriteByte 0x24000065 0x3F
# vy=0.5f (0x3F000000 LE: 00 00 00 3F)
sysbus WriteByte 0x24000066 0x00
sysbus WriteByte 0x24000067 0x00
sysbus WriteByte 0x24000068 0x00
sysbus WriteByte 0x24000069 0x3F
# vz=-0.1f (0xBDCCCCCD LE: CD CC CC BD)
sysbus WriteByte 0x2400006A 0xCD
sysbus WriteByte 0x2400006B 0xCC
sysbus WriteByte 0x2400006C 0xCC
sysbus WriteByte 0x2400006D 0xBD
# CRC placeholder
sysbus WriteByte 0x2400006E 0x00
sysbus WriteByte 0x2400006F 0x00

# Signal 76 bytes total (40 + 36)
sysbus WriteDoubleWord 0x24000010 0x0000004C
emulation RunFor "0.1"

# === TRIGGER FRAME-SYNC ===
sysbus WriteDoubleWord 0x24000018 0x00001388  # timestamp = 5000 us
sysbus WriteDoubleWord 0x24000014 0x00000001  # trigger
emulation RunFor "0.2"

quit
