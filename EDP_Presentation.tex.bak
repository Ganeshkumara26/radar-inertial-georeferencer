% ===== SLIDE 39: Renode Setup =====
\begin{frame}{Renode Verification Environment}
\begin{block}{Simulation script structure}
\begin{enumerate}
\item \texttt{mach create} â€” Create the virtual machine
\item \texttt{LoadPlatformDescription} â€” Load STM32H753 repl (CRC commented out)
\item \texttt{LoadELF} â€” Load compiled firmware binary
\texttt{CreateFileBackend} â€” Capture UART output to log
\item \texttt{WriteByte/WriteDoubleWord} â€” Inject MAVLink packets via backdoors
\item \texttt{RunFor} â€” Advance virtual time, execute firmware
\item Inspect \texttt{uart\_output.log} for expected output
\end{enumerate}
\end{block}
\vspace{2mm}
\textbf{Determinism}: Same binary + same script = identical execution trace. Every result is reproducible.
\end{frame}

% ===== SLIDE 40: Simulation Backdoors =====
\begin{frame}{Simulation Backdoors for HIL}
\begin{block}{Why backdoors?}
Renode does not model DMAMUX1 (USART$\rightarrow$DMA routing), so real DMA cannot move bytes. Instead, Renode writes bytes directly to the DMA buffer in AXI SRAM.
\end{block}
\vspace{2mm}
\textbf{Backdoor addresses} (in AXI SRAM gap \texttt{0x24000010}--\texttt{0x2400001F}):
\begin{itemize}
\item \texttt{0x24000010}: \texttt{sim\_rx\_count} â€” RX byte count (parser reads instead of DMA NDTR)
\item \texttt{0x24000014}: \texttt{sim\_frame\_sync} â€” Write nonzero to trigger frame-sync ISR
\item \texttt{0x24000018}: \texttt{sim\_frame\_ts} â€” Timestamp value (microseconds)
\item \texttt{0x2400001C}: \texttt{sim\_radar\_trigger} â€” Write nonzero to re-arm radar target
\end{itemize}
\end{frame}

% ===== SLIDE 41: pymavlink Generation =====
\begin{frame}[fragile]{pymavlink â€” Real MAVLink v2 Packets}
\begin{block}{Why real packets?}
Testing with hand-written bytes only tests the parser. Real MAVLink packets with correct CRCs test the entire protocol stack.
\end{block}
\vspace{2mm}
\textbf{Stimuli generation}:
\begin{lstlisting}[style=plainstyle]
# Generate 50 frames of realistic flight data
python3 sim/generate_stimuli.py > sim/generated_stimuli.rescript
\end{lstlisting}
\vspace{2mm}
\textbf{Each frame contains}:
\begin{itemize}
\item ATTITUDE packet: roll/pitch/yaw with sinusoidal variations
\item LOCAL\_POSITION\_NED: position based on velocity integration
\item Frame-sync trigger every 10\,ms (100\,Hz MAVLink, 10\,Hz radar)
\item Correct MAVLink v2 CRCs computed by pymavlink
\end{itemize}
\end{frame}

