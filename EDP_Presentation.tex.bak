\section{Part 1: The Problem \& System Context}
% ==============================================================================

% ===== SLIDE 3: The CSSR Problem =====
\begin{frame}{The CSSR Problem â€” Spatial Drift Kills Rescue}
\textbf{What happens in a disaster?}
\begin{itemize}
\item Earthquakes, building collapses, explosions
\item Survivors trapped under rubble, behind walls
\item A drone carries radar to detect breathing signatures
\item \textbf{The problem}: The drone is moving at 2--5\,m/s
\end{itemize}
\vspace{2mm}
\textbf{Why does this matter?}
\begin{itemize}
\item Range bin 47 at time $T_1$ $\neq$ Range bin 47 at time $T_2$
\item Without georeferencing, the rescue map \textbf{drifts by meters}
\item A 1\,ms timing error at 3\,m/s = 3\,mm spatial drift
\item \textbf{Rescuers dig in the wrong place}
\end{itemize}
\end{frame}

% ===== SLIDE 4: Why Linux Fails =====
\begin{frame}{Why a Linux Companion Computer Fails}
\textbf{The naive approach}: Run georeferencing on a Jetson/Raspberry Pi running Linux.
\vspace{2mm}
\textbf{What goes wrong}:
\begin{itemize}
\item Linux is \textbf{not a real-time OS} â€” scheduling is best-effort
\item A background process (network, logging) can preempt the EKF for milliseconds
\item \textbf{OS jitter}: 1--10\,ms latency spikes are common
\item At 3\,m/s drone velocity, 5\,ms jitter = 1.5\,cm drift per measurement
\item Over 100 measurements, errors accumulate to meters
\end{itemize}
\vspace{2mm}
\textbf{The hard requirement}: Attitude-to-output latency must be \textbf{deterministic}, not just fast.
\end{frame}

% ===== SLIDE 5: Why STM32H7 =====
\begin{frame}{Why the STM32H7 Cortex-M7?}
\begin{block}{Deterministic by Design}
A bare-metal microcontroller has \textbf{no operating system}:
\begin{itemize}
\item No scheduler, no context switches, no page faults
\item Peripheral operations complete in \textbf{bounded clock cycles}
\item Hardware timers latch timestamps \textbf{atomically} â€” no software latency
\item DMA moves data without CPU intervention
\end{itemize}
\end{block}
\vspace{2mm}
\textbf{STM32H753XI capabilities}:
\begin{itemize}
\item 480\,MHz Cortex-M7 with hardware FPU (for EKF matrix math)
\item 32-bit free-running timers (1\,$\mu$s resolution)
\item DMA with circular buffer mode (zero-copy UART RX)
\item Hardware CRC accelerator (packet integrity)
\item Memory Protection Unit (memory safety)
\end{itemize}
\end{frame}

