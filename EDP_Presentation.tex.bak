\end{itemize}
\end{frame}

% ===== SLIDE 14: Renode Simulation =====
\begin{frame}{Renode — Deterministic Hardware Emulation}
\textbf{What is Renode?}
\begin{itemize}
\item Open-source functional simulator by Antmicro (MIT license)
\item Executes unmodified ARM binaries against a modeled SoC
\item \textbf{Fully deterministic}: same binary + same script = same trace
\item Driven by \texttt{.rescript} monitor scripts
\end{itemize}
\vspace{2mm}
\textbf{What Renode does NOT model} (silicon divergences):
\begin{itemize}
\item DMAMUX1 routing peripheral (USART$\rightarrow$DMA)
\item TIM2 input capture on GPIO edge
\item L1 cache coherency behavior
\item CRC hardware byte-ordering
\end{itemize}
\vspace{2mm}
\textbf{My approach}: Write firmware for silicon correctness first; use backdoors only for injection.
\end{frame}

% ==============================================================================
\section{Part 3: Pipeline Stages — CS01 to CS06}
% ==============================================================================

% ===== SLIDE 15: CS01 Boot Sequence =====
\begin{frame}{CS01: Boot Sequence \& Vector Table}
\textbf{How the STM32H7 boots}:
\begin{enumerate}
\item Hardware loads SP from vector table word 0 (\texttt{0x08000000})
\item Hardware loads PC from vector table word 1 (Reset\_Handler)
\item Reset\_Handler enables FPU (CPACR bits [23:20])
\item Reset\_Handler copies \texttt{.data} from Flash to SRAM
\item Reset\_Handler zeroes \texttt{.bss}
\item Reset\_Handler calls \texttt{main()}
\end{enumerate}
\vspace{2mm}
\textbf{The vector table}: 57 entries (indices 0--56). First 16 are Cortex-M core exceptions; entries 16--56 are device-specific interrupts. USART1 is IRQ 37, so its handler is at index 53.
\vspace{2mm}
\textbf{Bug found}: FPU not enabled. First floating-point store triggers UsageFault. Fix: write \texttt{0xF << 20} to CPACR in Reset\_Handler before any float operations.
\end{frame}

% ===== SLIDE 16: CS01 Reset Handler Code =====
\begin{frame}[fragile]{CS01: Reset\_Handler and FPU Enable}
\begin{block}{The critical startup code}
\begin{lstlisting}[style=cstyle]
void Reset_Handler(void) {
    /* Enable FPU CP10 and CP11 (Cortex-M7) */
    *(volatile uint32_t *)0xE000ED88 |= (0xFUL << 20);
    __asm__ volatile ("dsb");
    __asm__ volatile ("isb");

    /* Copy .data from Flash to SRAM */
    uint32_t *pSrc = &_etext;
    uint32_t *pDest = &_sdata;
    while (pDest < &_edata) *pDest++ = *pSrc++;

    /* Zero .bss */
    pDest = &_sbss;
    while (pDest < &_ebss) *pDest++ = 0;

    main();
    while (1) {}
}
\end{lstlisting}
\end{block}
\end{frame}

% ===== SLIDE 17: CS02 DMA Architecture =====
\begin{frame}{CS02: DMA Circular Buffer Architecture}
\begin{block}{Why DMA?}
Polling USART1 RX at 921600 baud means reading a byte every 10\,$\mu$s. At 480\,MHz, that is 4800 cycles per byte — wasted. DMA moves bytes autonomously; the CPU only wakes when a full packet is available.
\end{block}
\vspace{2mm}
\textbf{DMA1 Stream 0 configuration}:
\begin{itemize}
\item Source: \texttt{USART1\_RDR} (\texttt{0x40011024}) — peripheral address
\item Destination: \texttt{dma\_buffer[512]} in AXI SRAM (\texttt{0x24000020})
\item Mode: Circular (wraps to base after reaching end)
\item Priority: High
\item Data width: 8 bits (both peripheral and memory)
\item Interrupt: Transfer complete (for wrap detection)
\end{itemize}
\vspace{2mm}
\textbf{Parser polls} \texttt{DMA1\_S0NDTR} (remaining count) to detect new bytes. \texttt{write\_pos = 512 - NDTR}.
\end{frame}

% ===== SLIDE 18: CS02 Cache Coherency Bug =====
\begin{frame}[fragile]{CS02: Cache Coherency — The Silent Failure}
\begin{block}{What goes wrong}
The Cortex-M7 has a 16\,KB L1 data cache. When the CPU first reads \texttt{dma\_buffer[0]}, the cache line is loaded into L1. Then DMA writes new bytes directly to physical SRAM — \textbf{bypassing the cache}. The CPU keeps reading the \textbf{stale cached copy}.
\end{block}
\vspace{2mm}
\textbf{The fix}: Invalidate D-Cache lines before reading the buffer:
\begin{lstlisting}[style=cstyle]
static void invalidate_cache_line(uint32_t addr) {
    SCB_DCCIMVAC = addr & ~0x1FU;  /* Clean+Invalidate line */
    __asm__ volatile ("dsb 0xF" ::: "memory");
    __asm__ volatile ("isb 0xF");
}
\end{lstlisting}
\vspace{2mm}
\textbf{Renode divergence}: Renode has no L1 cache model, so the fix is a no-op in simulation. On physical silicon, omitting it causes silent data corruption.
\end{frame}

% ===== SLIDE 19: CS02 Struct Packing Bug =====
\begin{frame}[fragile]{CS02: Struct Packing — The Invisible Shift}
\begin{block}{What goes wrong}
GCC aligns \texttt{float} fields to 4-byte boundaries. The 6-byte MAVLink header causes the compiler to insert 2 bytes of \textbf{invisible padding} before the first float field. Casting the wire buffer directly to this struct reads all floats from the wrong offset.
\end{block}
\vspace{2mm}
\textbf{Before (buggy)}:
\begin{lstlisting}[style=cstyle]
typedef struct {
    uint8_t magic, length, seq, sysid, compid, msgid;
    float roll, pitch, yaw;  /* offset 8, not 6! */
} mavlink_attitude_t;
\end{lstlisting}
\vspace{2mm}
\textbf{After (fixed)}:
\begin{lstlisting}[style=cstyle]
typedef struct __attribute__((packed)) {
    uint32_t time_boot_ms;
    float roll, pitch, yaw;  /* offset 4, matches wire */
} mavlink_attitude_t;
\end{lstlisting}
\end{frame}

% ===== SLIDE 20: CS03 Timer Overview =====
\begin{frame}{CS03: TIM2 — Microsecond-Precision Timestamping}
\begin{block}{Why TIM2?}
The radar SoC asserts a frame-sync pulse every time it completes a sweep. We must latch the \textbf{exact microsecond} of this edge. Software reading a GPIO after an interrupt has variable latency (pipeline flush, ISR entry). Hardware input capture latches \texttt{TIM2\_CNT} into \texttt{TIM2\_CCR1} \textbf{atomically} on the GPIO edge.
\end{block}
\vspace{2mm}
\textbf{TIM2 configuration}:
\begin{itemize}
\item 32-bit free-running upcounter
\item Prescaler: 239 (240\,MHz / 240 = 1\,MHz = 1\,$\mu$s/tick)
\item Auto-reload: 0xFFFFFFFF (wraps every 71 minutes)
\item Channel 1: Input capture on TI1, rising edge
\item Overflow interrupt: Track wraparounds for long missions
\end{itemize}
\end{frame}

% ===== SLIDE 21: CS03 Prescaler Bug =====
\begin{frame}[fragile]{CS03: Prescaler Shadow Load Bug}
\begin{block}{What goes wrong}
Writing \texttt{TIM2\_PSC = 239} updates the \textbf{shadow register}, but the timer continues counting with the old prescaler. The counter does not increment at the correct rate until an explicit update event is generated.
\end{block}
\vspace{2mm}
\textbf{Symptom}: Timer stuck at 0 or counting at wrong rate.
\vspace{2mm}
\textbf{The fix}:
\begin{lstlisting}[style=cstyle]
TIM2_PSC = 239;           /* Write prescaler shadow */
TIM2_ARR = 0xFFFFFFFF;     /* Auto-reload */
TIM2_EGR = TIM_EGR_UG;     /* Generate update event! */
TIM2_CR1 = TIM_CR1_CEN | TIM_CR1_ARPE; /* Start */
\end{lstlisting}
\vspace{2mm}
\textbf{Key insight}: Many STM32 registers have shadow copies. Always check the reference manual for `update event'' requirements.
\end{frame}

% ===== SLIDE 22: CS03 Input Capture =====
\begin{frame}[fragile]{CS03: Input Capture and Priority Inversion}
\begin{block}{What goes wrong — Priority Inversion}
The EXTI frame-sync interrupt was initially configured at \textbf{higher} priority than TIM2. When frame-sync fires, the ISR reads \texttt{TIM2\_CCR1} — but the hardware capture hasn't completed yet. Returns stale value.
\end{block}
\vspace{2mm}
\textbf{The fix}: Use hardware input capture, not software read.
\begin{lstlisting}[style=cstyle]
/* Channel 1 as input, IC1 mapped on TI1 */
TIM2_CCMR1 = TIM_CCMR1_CC1S_0;
TIM2_CCER = TIM_CCER_CC1E | TIM_CCER_CC1P; /* Rising edge */
/* Hardware latches TIM2_CNT into TIM2_CCR1 on edge */
/* ISR just reads the already-captured value */
\end{lstlisting}
\end{frame}

% ===== SLIDE 23: CS04 Ring Buffer Design =====
\begin{frame}[fragile]{CS04: Lock-Free Ring Buffer}
\begin{block}{Why lock-free?}
The parser (producer) and EKF (consumer) run in the same main loop but are logically separate stages. A mutex would require an OS. Instead, we use a single-producer/single-consumer ring buffer with \textbf{atomic index updates} and memory barriers.
\end{block}
\vspace{2mm}
\textbf{Design}:
\begin{lstlisting}[style=cstyle]
#define RING_BUFFER_SIZE 64  /* Power of 2 */
#define RING_BUFFER_MASK (RING_BUFFER_SIZE - 1)

typedef struct {
    kinematic_state_t entries[RING_BUFFER_SIZE];
    volatile uint32_t head;  /* Write index (producer) */
    volatile uint32_t tail;  /* Read index (consumer) */
    uint32_t overflow_count;
} ring_buffer_t;
\end{lstlisting}
\vspace{2mm}
\textbf{Push}: Write to \texttt{entries[head]}, \texttt{DMB}, update \texttt{head}.
\textbf{Pop}: \texttt{DMB}, read \texttt{entries[tail]}, update \texttt{tail}.
\end{frame}

% ===== SLIDE 24: CS04 DMB Barriers =====
\begin{frame}[fragile]{CS04: DMB â€” Memory Barrier Bug}
\begin{block}{What goes wrong}
The Cortex-M7 has an out-of-order pipeline with a write buffer. Without a barrier, the index update (\texttt{head++}) can complete \textbf{before} the data write reaches SRAM. The consumer sees the updated index but reads stale data.
\end{block}
\vspace{2mm}
\textbf{The fix}:
\begin{lstlisting}[style=cstyle]
void ring_buffer_push(ring_buffer_t *rb, const kinematic_state_t *state) {
    uint32_t next_head = (rb->head + 1) & RING_BUFFER_MASK;
    if (next_head == rb->tail) { /* full */ return -1; }
    rb->entries[rb->head] = *state;
    __asm__ volatile ("dmb" ::: "memory");  /* ENSURE ORDERING */
    rb->head = next_head;
    return 0;
}
\end{lstlisting}
\vspace{2mm}
\textbf{Full/empty ambiguity fix}: Sacrifice one slot. Buffer holds 63 entries. Full when \texttt{(head+1) \& MASK == tail}.
\end{frame}

% ===== SLIDE 25: CS05 EKF Overview =====
\begin{frame}{CS05: 6-State Extended Kalman Filter}
\begin{block}{State vector and models}
$$\mathbf{x} = \begin{bmatrix} p_n & p_e & p_d & v_n & v_e & v_d \end{bmatrix}^T$$
\end{block}
\vspace{2mm}
\textbf{Prediction} (constant velocity):
$$\mathbf{x}_{k|k-1} = \mathbf{F} \mathbf{x}_{k-1|k-1}, \quad \mathbf{P}_{k|k-1} = \mathbf{F} \mathbf{P} \mathbf{F}^T + \mathbf{Q}$$
\textbf{Update} (radar measurement $\mathbf{z} = [r, \theta, \phi, \dot{r}]$):
$$\mathbf{K} = \mathbf{P} \mathbf{H}^T (\mathbf{H} \mathbf{P} \mathbf{H}^T + \mathbf{R})^{-1}$$
$$\mathbf{x}_{k|k} = \mathbf{x}_{k|k-1} + \mathbf{K}(\mathbf{z} - h(\mathbf{x}_{k|k-1}))$$
$$\mathbf{P}_{k|k} = (\mathbf{I} - \mathbf{K} \mathbf{H}) \mathbf{P}_{k|k-1}$$
\vspace{2mm}
\textbf{CMSIS-DSP}: \texttt{arm\_mat\_mult\_f32}, \texttt{arm\_mat\_inverse\_f32} for matrix operations on Cortex-M7 FPU.
\end{frame}

% ===== SLIDE 26: CS05 Matrix Aliasing Bug =====
\begin{frame}[fragile]{CS05: Matrix Aliasing â€” Buffer Overwrite}
\begin{block}{What goes wrong}
All intermediate matrices (\texttt{tmp6x6}, \texttt{tmp4x6}, etc.) initially shared the same buffer. CMSIS-DSP arm\_mat\_mult\_f32 writes results sequentially. When source and destination overlap, the function \textbf{overwrites its own inputs} mid-computation.
\end{block}
\vspace{2mm}
\textbf{Symptom}: EKF diverges to NaN after first update.
\textbf{The fix}: Distinct scratchpad for every intermediate:
\begin{lstlisting}[style=cstyle]
static float scratch_F[36];    /* State transition */
static float scratch_FT[36];   /* F transpose */
static float scratch_FP[36];   /* F*P product */
static float scratch_FPFt[36]; /* F*P*F' product */
static float scratch_Pnew[36]; /* Updated covariance */
/* ... plus 4x6, 4x4 scratchpads for update step */
\end{lstlisting}
\end{frame}

% ===== SLIDE 27: CS05 Jacobian Bug =====
\begin{frame}[fragile]{CS05: Jacobian and Measurement Model Bugs}
\begin{block}{Bug 1: Missing sqrtf}
Range prediction used r\textasciicircum{}2 instead of sqrt(r\textasciicircum{}2):
\begin{lstlisting}[style=cstyle]
float r2 = pn*pn + pe*pe + pd*pd;
float range_pred = sqrtf(r2 > 1e-6f ? r2 : 1e-6f);  /* Fixed */
\end{lstlisting}
\end{block}
\vspace{2mm}
\begin{block}{Bug 2: Angles in meters, not radians}
Azimuth prediction used raw position pe instead of atan2(pe, pn):
\begin{lstlisting}[style=cstyle]
float r_ground = sqrtf(pn*pn + pe*pe);
float azimuth_pred = atan2f(pe, pn);        /* Fixed */
float elevation_pred = atan2f(-pd, r_ground); /* Fixed */
\end{lstlisting}
\end{block}
\vspace{2mm}
\begin{block}{Bug 3: Incomplete Jacobian}
Rows 1 and 2 of the 4x6 matrix H were left zero â€” angle measurements never updated the state. Fixed by computing all partial derivatives.
\end{block}
\end{frame}

% ===== SLIDE 28: CS06 Quaternion Rotation =====
\begin{frame}[fragile]{CS06: Quaternion-Based Coordinate Transform}
\begin{block}{The rotation bug}
The quaternion rotation used the \textbf{conjugate} instead of the forward quaternion. This rotates targets in the \textbf{opposite direction} â€” the rescue map shows targets on the wrong side of the drone.
\end{block}
\vspace{2mm}
\textbf{Correct rotation}: v\textquotesingle{} = q * v * q\textasciicircum{}-1
\begin{lstlisting}[style=cstyle]
static void quat_rotate_vector(const quaternion_t *q,
                                float vx, float vy, float vz,
                                float *ox, float *oy, float *oz) {
    float qw = q->w, qx = q->x, qy = q->y, qz = q->z;
    float tx = 2.0f * (qy * vz - qz * vy);
    float ty = 2.0f * (qz * vx - qx * vz);
    float tz = 2.0f * (qx * vy - qy * vx);
    *ox = vx + qw * tx + (qy * tz - qz * ty);
    *oy = vy + qw * ty + (qz * tx - qx * tz);
    *oz = vz + qw * tz + (qx * ty - qy * tx);
}
\end{lstlisting}
\end{frame}
% ==============================================================================
\section{Part 4: Pipeline Stages â€” CS07 to CS11}
% ==============================================================================

% ===== SLIDE 29: CS06 ENU to WGS84 =====
\begin{frame}[fragile]{CS06: ENU to WGS84 Conversion}
\begin{block}{The final coordinate transform}
After quaternion rotation, targets are in the local ENU frame. Convert to WGS84:
\begin{lstlisting}[style=cstyle]
double lat_rad = ref->ref_latitude * M_PI / 180.0;
double N = 6378137.0 / sqrt(1.0 - 0.00669438 * sin(lat_rad)*sin(lat_rad));
double dlat = (double)enu->n / (N + (double)ref->ref_altitude);
double dlon = (double)enu->e / ((N + (double)ref->ref_altitude) * cos(lat_rad));
wgs84->latitude  = ref->ref_latitude + dlat * 180.0 / M_PI;
wgs84->longitude = ref->ref_longitude + dlon * 180.0 / M_PI;
wgs84->altitude  = ref->ref_altitude + enu->u;
\end{lstlisting}
\end{block}
\vspace{2mm}
\textbf{Bug fix}: Used \texttt{double} for the ENU-to-WGS84 calculation. Single-precision \texttt{sin(lat)} loses precision near the equator.
\end{frame}

% ===== SLIDE 30: CS07 Output Frame Format =====
\begin{frame}[fragile]{CS07: Binary Output Frame Format}
\begin{block}{Frame structure (46+ bytes)}
\begin{lstlisting}[style=cstyle]
typedef struct __attribute__((packed)) {
    uint8_t  magic;          /* 0xED */
    uint8_t  version;        /* 0x01 */
    uint16_t length;         /* Actual packed length */
    uint32_t sequence;       /* Monotonic counter */
    uint32_t timestamp_us;   /* Frame creation time */
    uint8_t  target_count;   /* Number of targets */
    uint8_t  status;         /* System status */
} output_header_t;  /* 14 bytes */

typedef struct __attribute__((packed)) {
    double   latitude;       /* WGS84 degrees */
    double   longitude;
    float    altitude;       /* meters */
    float    vel_east, vel_north, vel_up;
    float    snr;
    uint32_t timestamp_us;
} output_target_record_t;  /* 32 bytes each */
\end{lstlisting}
\end{block}
\end{frame}

% ===== SLIDE 31: CS07 Bus Contention =====
\begin{frame}[fragile]{CS07: Frame Length Bug and SPI Contention}
\begin{block}{Bug: Frame length mismatch}
The header's \texttt{length} field was computed from \texttt{count * 32}, but invalid targets were skipped during packing. The actual packed bytes were fewer. Ground station read garbage.
\textbf{Fix}: Track actual offset after packing, update \texttt{length}.
\end{block}
\vspace{2mm}
\begin{block}{SPI vs USART DMA contention}
Initially used USART polled TX for output â€” this \textbf{blocked the CPU} for 1.4\,ms per frame, missing EKF deadlines.
\textbf{Fix}: Use SPI1 with DMA2 (separate bus from USART1 RX on DMA1). CPU never blocks.
\end{block}
\end{frame}

% ===== SLIDE 32: CS08 Bounds Checking =====
\begin{frame}[fragile]{CS08: Fault Resilience â€” Bounds Checking}
\begin{block}{Bug: Buffer overflow}
A MAVLink packet with \texttt{length = 255} but only 20 bytes of payload caused an \textbf{out-of-bounds read} at \texttt{pos + header + length}.
\end{block}
\vspace{2mm}
\textbf{The fix}:
\begin{lstlisting}[style=cstyle]
if (magic == MAVLINK_V2_MAGIC) {
    if (pos + MAVLINK_HEADER_LEN > write_pos) break;
    pkt_len = MAVLINK_HEADER_LEN + parser->dma_buffer[pos + 1]
              + MAVLINK_CHECKSUM_LEN;
    if ((pos + pkt_len) > write_pos) break;  /* Incomplete */
    /* ... process packet ... */
}
\end{lstlisting}
\vspace{2mm}
\textbf{Test}: Injected 10,000 malformed packets. System continues operating. \texttt{packets\_dropped} counter increments, no crash.
\end{frame}

% ===== SLIDE 33: CS08 NaN and Overflow =====
\begin{frame}[fragile]{CS08: NaN Injection and Ring Buffer Overflow}
\begin{block}{Bug 1: NaN injection}
A MAVLink ATTITUDE packet with \texttt{roll = NaN} propagates through the EKF: \texttt{NaN * anything = NaN}. Once in, never recovers.
\textbf{Fix}: Validate all parsed floats:
\begin{lstlisting}[style=cstyle]
#include <math.h>
if (!is_valid_float(att->roll) || !is_valid_float(att->pitch)) {
    parser->packets_dropped++;
    break;  /* Reject packet, keep previous state */
}
\end{lstlisting}
\end{block}
\vspace{2mm}
\begin{block}{Bug 2: Ring buffer overflow}
Parser produces states faster than EKF consumes. Buffer fills, states lost.
\textbf{Fix}: Increase to 256 slots; drain completely each loop iteration.
\end{block}
\end{frame}

% ===== SLIDE 34: CS09 MPU Configuration =====
\begin{frame}[fragile]{CS09: MPU â€” Execute-Never Bug}
\begin{block}{What goes wrong}
The MPU marks the SDRAM region as \textbf{Execute-Never (XN)} by default. If a function pointer table is accidentally placed in SDRAM (by linker), calling it triggers a MemManage fault.
\end{block}
\vspace{2mm}
\textbf{The fix}: Configure MPU Region 0 for SDRAM:
\begin{itemize}
\item Base: \texttt{0xD0000000}, Size: 32\,MB
\item If code execution needed: \texttt{XN=0} in RASR
\item If data-only: \texttt{XN=1} (default, safer)
\end{itemize}
\vspace{2mm}
\textbf{Defense in depth}: Keep code in Flash. SDRAM is data-only. Linker script enforces this with separate \texttt{.sdram\_data} section.
\end{frame}

% ===== SLIDE 35: CS09 Cache Strategy =====
\begin{frame}{CS09: Cache Coherency Strategy}
\begin{block}{Three strategies for DMA buffer coherency}
\begin{enumerate}
\item \textbf{TCM SRAM}: Place buffers in Tightly-Coupled Memory (always non-cacheable). \textit{Downside}: Only 128\,KB, need most for stacks.
\item \textbf{Non-cacheable MPU region}: Mark AXI SRAM buffer region as non-cacheable via MPU. \textit{Downside}: Slower for CPU access.
\item \textbf{Manual cache maintenance}: Keep buffers in AXI SRAM (cacheable), invalidate before read. \textit{Downside}: Must remember to invalidate.
\end{enumerate}
\end{block}
\vspace{2mm}
\textbf{This firmware uses strategy 3}: Manual \texttt{SCB\_InvalidateDCache\_by\_Addr()} before reading DMA buffer. Maximizes cache benefit for EKF matrices while maintaining correctness.
\end{frame}

% ===== SLIDE 36: CS10 WFI Power Management =====
\begin{frame}[fragile]{CS10: WFI â€” Lost Wakeup Race}
\begin{block}{What goes wrong}
The check-then-sleep sequence is not atomic:
\begin{lstlisting}[style=cstyle]
if (no_work_pending()) {
    __asm__ volatile ("wfi");  /* Interrupt can fire here! */
}
\end{lstlisting}
If an interrupt fires between the check and the \texttt{wfi}, the wakeup is lost. CPU sleeps until the next interrupt (possibly 10\,ms later).
\end{block}
\vspace{2mm}
\textbf{The fix}: PRIMASK critical section:
\begin{lstlisting}[style=cstyle]
__asm__ volatile ("cpsid i");    /* Disable interrupts */
if (no_work_pending()) {
    __asm__ volatile ("wfi");     /* Safe: wakes on pending */
    __asm__ volatile ("cpsie i"); /* Re-enable after wake */
} else {
    __asm__ volatile ("cpsie i"); /* Re-enable */
}
\end{lstlisting}
\end{frame}

% ===== SLIDE 37: CS10 Sleep Mode =====
\begin{frame}[fragile]{CS10: Sleep Mode vs Stop Mode}
\begin{block}{Bug: SLEEPDEEP bit set}
I initially set the \texttt{SLEEPDEEP} bit in \texttt{SCB\_CR}, which stops \textbf{all} clocks including TIM2. The timer stops counting, and the frame-sync capture never occurs.
\textbf{Fix}: Use Sleep mode (SLEEPDEEP=0). Peripherals remain clocked.
\end{block}
\vspace{2mm}
\textbf{Verification}: In Renode, verify that TIM2 continues counting during idle periods. On silicon, toggle a GPIO at each pipeline iteration and measure with logic analyzer â€” should see consistent 100\,Hz iteration rate with gaps during WFI.
\end{frame}

% ===== SLIDE 38: CS11 Integration Bugs =====
\begin{frame}[fragile]{CS11: Full Pipeline Integration Bugs}
\begin{block}{Bug 1: Parser multi-packet loss}
Parser processed ALL packets in one call but only returned the LAST packet's data. Earlier packets were lost.
\textbf{Fix}: Process one packet per call, save read position for next invocation.
\end{block}
\vspace{2mm}
\begin{block}{Bug 2: Ring buffer pop overwrites push}
When buffer was full, the pop used the same \texttt{state} variable as the push:
\begin{lstlisting}[style=cstyle]
ring_buffer_pop(&rb, &state);  /* OVERWRITES state! */
ring_buffer_push(&rb, &state); /* Pushes old data */
\end{lstlisting}
\textbf{Fix}: Use a separate \texttt{dummy} variable for the pop.
\end{block}
\end{frame}
