\section{Part 2: Hardware Platform \& Tooling}
% ==============================================================================

% ===== SLIDE 9: STM32H7 Architecture =====
\begin{frame}{STM32H753XI — Architecture Overview}
\begin{columns}[T]
\begin{column}{0.55\textwidth}
\textbf{Core}:
\begin{itemize}
\item Cortex-M7 @ 480\,MHz
\item 16\,KB L1 I-Cache + 16\,KB L1 D-Cache
\item Hardware FPU (FPv5-D16, double-precision)
\item 2\,MB internal Flash
\item 512\,KB AXI SRAM
\end{itemize}
\end{column}
\begin{column}{0.45\textwidth}
\textbf{Peripherals used}:
\begin{itemize}
\item USART1 (MAVLink RX)
\item DMA1 Stream 0 (zero-copy)
\item TIM2 (32-bit timer)
\item SPI1 (output)
\item CRC (packet check)
\item MPU (memory safety)
\item FMC (external SDRAM)
\end{itemize}
\end{column}
\end{columns}
\end{frame}

% ===== SLIDE 10: Memory Map =====
\begin{frame}{Memory Map — Where Everything Lives}
\begin{block}{Three memory regions}
\begin{center}
\begin{tabular}{llll}
\toprule
\textbf{Region} & \textbf{Address} & \textbf{Size} & \textbf{Contents} \\
\midrule
Flash & \texttt{0x08000000} & 2\,MB & Code, vector table, rodata \\
AXI SRAM & \texttt{0x24000000} & 512\,KB & Data, BSS, stacks, buffers \\
SDRAM & \texttt{0xD0000000} & 32\,MB & Kinematic history (optional) \\
\bottomrule
\end{tabular}
\end{center}
\end{block}
\vspace{2mm}
\textbf{Key insight}: The DMA buffer lives in AXI SRAM at \texttt{0x24000020}. The CPU reads the same address through its L1 D-Cache. \textbf{Two masters, one memory} — this is the root cause of the cache coherency bug in CS02.
\end{frame}

