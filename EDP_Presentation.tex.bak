% ===== SLIDE 12: Clock Tree =====
\begin{frame}{Clock Tree — 480\,MHz Core, 240\,MHz Timers}
\begin{block}{Clock sources and dividers}
\begin{center}
\begin{tikzpicture}[node distance=0.5cm and 0.6cm,block/.style={draw,rounded corners,minimum width=1.5cm,minimum height=0.4cm,align=center,font=\scriptsize}]
\node[block,fill=lightorange](hse){HSE\\25\,MHz};
