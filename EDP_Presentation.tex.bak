% ===== SLIDE 43: Defect Taxonomy =====
\begin{frame}{Defect Taxonomy â€” 17 Bugs Across 11 Stages}
\begin{center}
\begin{tabular}{p{2.5cm} p{4.5cm} p{3.0cm}}
\toprule
\textbf{Category} & \textbf{Example} & \textbf{Stages} \\
\midrule
Build/Toolchain & IRQn typo, linker nostdlib & CS01 \\
Compiler boundary & Struct padding shift & CS02 \\
Silicon boundary & Cache coherency, timer prescaler, EKF aliasing, quat direction & CS02,03,05,06 \\
Algorithm/Protocol & Parser multi-packet, frame length, missing sqrtf & CS05,07,11 \\
Memory safety & Buffer overflow, NaN injection, MPU XN & CS08,09 \\
Concurrency & DMB barriers, WFI race & CS04,10 \\
\bottomrule
\end{tabular}
\end{center}
\vspace{2mm}
\textbf{Key insight}: Each bug was cheap to fix (few lines) but expensive to find. Each demanded different evidence: register trace, linker error, injected test, reference manual re-read.
\end{frame}

% ===== SLIDE 44: Simulator vs Silicon =====
\begin{frame}{Simulator vs Silicon â€” Fidelity Gaps}
\begin{center}
\begin{tabular}{p{3.5cm} p{4.0cm} p{3.5cm}}
\toprule
\textbf{Peripheral} & \textbf{Renode Limitation} & \textbf{Firmware Response} \\
\midrule
DMAMUX1 & Not modeled & Backdoor injection \\
TIM2 capture & Not supported & Timestamp via backdoor \\
CRC hardware & Simplified & Skip CRC in simulation \\
L1 Cache & Not modeled & Manual invalidate (no-op in Renode) \\
MPU XN & Not enforced & MPU configured, relies on HW \\
\bottomrule
\end{tabular}
\end{center}
\vspace{2mm}
\textbf{Principle}: Firmware written for silicon correctness first. Renode divergences are worked around, not hidden.
\end{frame}

% ===== SLIDE 45: Full Pipeline Performance =====
\begin{frame}{Full Pipeline Performance Summary}
\begin{block}{Resource usage}
\begin{itemize}
\item \textbf{Flash}: 19.5\,KB of 2\,MB (1\%)
\item \textbf{AXI SRAM}: 12.6\,KB of 512\,KB (2.5\%)
\item \textbf{CPU}: 480\,MHz, EKF update $<$1\,ms deterministic
\item \textbf{DMA}: Zero CPU overhead for UART RX and SPI TX
\end{itemize}
\end{block}
\vspace{2mm}
\begin{block}{Timing}
\begin{itemize}
\item MAVLink parsing: $<$50\,$\mu$s per packet (DMA + cache invalidate)
\item EKF predict: $<$200\,$\mu$s (6-state, CMSIS-DSP)
\item EKF update: $<$500\,$\mu$s (matrix inverse + Kalman gain)
\item Coordinate transform: $<$50\,$\mu$s (quaternion + WGS84)
\item \textbf{Total}: $<$1\,ms end-to-end (well within 10\,ms budget)
\end{itemize}
\end{block}
\end{frame}

