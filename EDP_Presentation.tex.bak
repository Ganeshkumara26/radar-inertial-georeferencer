\midrule
USART1 & \texttt{0x40011000} & CR1, BRR, ISR, RDR, TDR \\
DMA1 Stream 0 & \texttt{0x40020000} & CR, NDTR, PAR, M0AR \\
TIM2 & \texttt{0x40000000} & CR1, PSC, ARR, CNT, CCR1, SR \\
SPI1 & \texttt{0x40013000} & CR1, CR2, SR, DR \\
